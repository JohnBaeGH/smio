{
  "expo": {
    "name": "Smio",
    "slug": "smio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "smio",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3b82f6"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.smio.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#3b82f6"
      },
      "package": "com.smio.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png",
      "name": "Smio - 스마트 팀 주문"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
