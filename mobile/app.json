{
  "expo": {
    "name": "Smio",
    "slug": "smio",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "smio",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F0FF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.smio.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6B4EFF"
      },
      "package": "com.smio.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png",
      "name": "Smio - 스마트 팀 주문"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "fdcf6a2c-1f3e-4a9d-add3-14f46c08ffeb"
      }
    },
    "owner": "johnb-organization",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fdcf6a2c-1f3e-4a9d-add3-14f46c08ffeb"
    }
  }
}
